# API: localhost (dev) hoặc tunnel để khác máy/khác mạng (chạy: npm run tunnel trong MO)
# VITE_API_BASE_URL=http://localhost:5274/
# VITE_API_BASE_URL=https://fptfe.loca.lt/
VITE_API_BASE_URL=http://localhost:5274/

# Gemini API Key
# Get your key at https://aistudio.google.com/apikey
