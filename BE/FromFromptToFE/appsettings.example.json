{
  "ConnectionStrings": {
    "ConnectionString": "Server=your_db_host;Port=5432;Database=your_database;User Id=your_user;Password=your_password;SSL Mode=Require;Trust Server Certificate=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5274"
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SecretKey": "your_jwt_secret_key_at_least_32_characters_long",
    "Issuer": "FromPromptToFE",
    "Audience": "FromPromptToFEUser"
  },
  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderName": "FromPromptToFE Team",
    "SenderEmail": "your_email@gmail.com",
    "Username": "your_email@gmail.com",
    "Password": "your_app_password"
  },
  "FrontendUrl": "http://localhost:5173",
  "GitHub": {
    "ClientId": "your_github_client_id",
    "ClientSecret": "your_github_client_secret",
    "RedirectUri": "http://localhost:5173/auth/github/callback"
  },
  "Gemini": {
    "ApiKey": "your_gemini_api_key"
  },
  "AllowedOrigins": [
    "http://localhost:5173",
    "http://localhost:3000",
    "http://localhost:3001",
    "http://localhost:8081"
